<div class="voice-message-wrapper">
    <div class="voice-message">
        <button type="button" class="voice-message__play" data-component="voice-play">
            <img src="/assets/images/icons/playIcon.svg" alt="Play" data-component="voice-play-icon">
        </button>
        <div class="voice-message__visualizer" data-component="voice-visualizer"></div>
        <div class="voice-message__info">
            <div class="voice-message__duration" data-component="voice-duration">00:00</div>
            <button type="button" class="voice-message__stt" data-component="voice-stt" title="Расшифровать в текст">T</button>
        </div>
    </div>
    <div class="voice-message__transcript" data-component="voice-transcript">
        <div class="voice-message__transcript-loader" data-component="voice-transcript-loader" hidden>
            <span class="voice-message__dot"></span>
            <span class="voice-message__dot"></span>
            <span class="voice-message__dot"></span>
        </div>
        <div class="voice-message__transcript-text" data-component="voice-transcript-text"></div>
    </div>
</div>
